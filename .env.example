# ==============================================================================
# eTeacher Profiling System (CS Form 212 Revised 2026 | CES / DEPED)
# Docker Compose Environment Configuration
# ==============================================================================

# Web & Proxy Port (Change to 8080 or other if port 80 is occupied)
PORT=80

# PostgreSQL Database Configuration
DB_NAME=eteacher_profiling_db
DB_USER=postgres
DB_PASSWORD=YourSecureDatabasePassword2026!
DB_EXTERNAL_PORT=5432

# Django Application Security
SECRET_KEY=django-insecure-generate-a-strong-random-key-for-production-deployment-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,web

# CORS and CSRF Configuration (Add your server domain or IP)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
